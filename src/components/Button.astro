---
export interface Props {
  href?: string
  variant?: 'primary-sky' | 'outline-sky' | 'primary-navy' | 'outline-navy' | 'icon'
  size?: 'sm' | 'md' | 'lg'
  class?: string
  [key: string]: any
}

const { href, variant = 'primary-sky', size = 'md', class: className = '', type, ...rest } = Astro.props as Props

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2',
  lg: 'px-6 py-2',
}

const variants = {
  'primary-sky': 'bg-brand-cyan text-white hover:bg-brand-cyan-dark',
  'outline-sky': 'border border-brand-cyan text-brand-cyan hover:bg-brand-cyan/10',
  'primary-navy': 'bg-brand-navy text-white hover:bg-brand-navy-dark',
  'outline-navy': 'border border-brand-navy/30 text-brand-navy hover:bg-brand-navy/5',
  'primary': 'bg-brand-navy text-white hover:bg-brand-navy-dark',
  'secondary': 'border border-brand-navy/30 text-brand-navy hover:bg-brand-navy/5',
  icon: '',
}

const base =
  variant === 'icon'
    ? 'shrink-0 rounded-full border p-2'
    : `rounded-pill font-medium ${sizes[size]} ${variants[variant]} disabled:opacity-50 disabled:cursor-not-allowed`

const Tag = href ? 'a' : 'button'
---

<Tag href={href} type={!href ? (type ?? 'button') : undefined} class={`${base} ${className}`} {...rest}>
  <slot />
</Tag>
