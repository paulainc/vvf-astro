---
export interface Props {
  tone?: 'white' | 'yellow' | 'pink' | 'blue'
  as?: 'div' | 'a' | 'article'
  href?: string
  shadow?: boolean
  overflowHidden?: boolean
  class?: string
}

const {
  tone = 'white',
  as,
  href,
  shadow = tone === 'white',
  overflowHidden = false,
  class: className = '',
  ...rest
} = Astro.props as Props

const toneClass = {
  white: 'bg-white',
  yellow: 'bg-pastel-sun',
  pink: 'bg-pastel-salmon',
  blue: 'bg-pastel-sky',
}[tone]

const Tag = href ? 'a' : (as ?? 'div')

const classes = [toneClass, 'rounded-card', shadow && 'shadow-sm', overflowHidden && 'overflow-hidden', className]
  .filter(Boolean)
  .join(' ')
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
