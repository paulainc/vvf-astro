---
import Button from './Button.astro'

export interface Props {
  tierName: string
  price: string
  features?: string[]
  href: string
  tone?: 'yellow' | 'blue'
}

const { tierName, price, features = [], href, tone = 'blue' } = Astro.props as Props
const toneClass = tone === 'yellow' ? 'bg-pastel-sun' : 'bg-pastel-sky'
---

<div class={`${toneClass} rounded-card p-6`}>
  <p class="font-display text-lg text-brand-navy">{tierName}</p>
  <p class="mt-1 text-display-sm text-brand-navy">{price}</p>
  {
    features.length > 0 && (
      <ul class="mt-4 space-y-1 text-sm text-ink-700">
        {features.map((f) => (
          <li>• {f}</li>
        ))}
      </ul>
    )
  }
  <Button href={href} variant="primary-navy" class="mt-4 inline-block text-sm">
    Buy Now
  </Button>
</div>
