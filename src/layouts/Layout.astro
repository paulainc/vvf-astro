---
import '../index.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Victoria Venezuela Foundation - Empowering communities' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content={description}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <style is:global>
      :root {
         /* VVF Design System Tokens */
         --color-bg: #ffffff;
         --color-surface: #f2f2f2;
         --color-fg: #333333;
         --color-muted: #758696;
         --color-border: #e7e7e7;
         --color-navy: #02335e;
         --color-navy-dark: #012244;
         --color-sky: #00abf9;
         --color-pastel-sun: #f9eac6;
         --color-pastel-salmon: #ffd7d7;
         --color-pastel-sky: #c1e7f5;
         /* Legacy aliases */
         --color-pastel-yellow: #f9eac6;
         --color-pastel-pink: #ffd7d7;
         --color-pastel-blue: #c1e7f5;
         --color-gray-900: #333333;
         --color-gray-700: #4a4a4a;
         --color-gray-600: #758696;
         --color-gray-50: #f2f2f2;
         --color-white: #ffffff;
         --font-display: 'Poppins', system-ui, -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
         --font-sans: 'Open Sans', system-ui, -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
         /* Layout */
         --radius: 8px;
         --border-width: 1px;
       }
       
       * {
         margin: 0;
         padding: 0;
         box-sizing: border-box;
       }
       
       body {
         font-family: var(--font-sans);
         line-height: 1.6;
         color: var(--color-gray-900);
       }
       
       a {
         color: var(--color-sky);
         text-decoration: none;
       }

       h1, h2, h3, h4, .font-display {
         font-family: var(--font-display);
         font-weight: 700;
       }
       
       a:hover {
         text-decoration: underline;
       }
       
       img {
         max-width: 100%;
         height: auto;
       }
     </style>
   </head>
  <body class="font-sans antialiased">
    <slot/>
   </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('button[aria-label="Mobile menu"]') || 
                           document.querySelector('button.flex.md\\:hidden');
     
     if (mobileMenuButton) {
       mobileMenuButton.addEventListener('click', function() {
         const nav = this.closest('header').querySelector('nav');
         const menu = nav.querySelector('ul.hidden.md\\:flex');
         if (menu) {
           menu.classList.toggle('hidden');
           menu.classList.toggle('absolute');
           menu.classList.toggle('inset-x-0');
           menu.classList.toggle('top-full');
           menu.classList.toggle('bg-white');
           menu.classList.toggle('shadow-lg');
           menu.classList.toggle('flex');
           menu.classList.toggle('flex-col');
           menu.classList.toggle('p-4');
           menu.classList.toggle('space-y-4');
         }
       });
     }
   });
</script>
