---
import PageLayout from '../../layouts/PageLayout.astro'
import FaqAccordion from '../../components/FaqAccordion.astro'
import { getFaqs } from '../../lib/content'

const faqs = await getFaqs('sponsorship')
---

<PageLayout title="Sponsor a Child — Victoria Venezuela Foundation">
  <section class="bg-gray-100">
    <div class="container max-w-container mx-auto px-4 py-12">
      <div class="bg-white rounded-card shadow p-8 max-w-xl ml-auto">
        <h1 class="text-display-md">Sponsor a child in Venezuela</h1>
        <p class="mt-3 text-ink-700">Build a personal connection. Transform a life.</p>
        <div class="mt-6 flex gap-3">
          <a href="/sponsor-a-child/children" class="rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">Meet the children</a>
          <a href="#how-it-works" class="rounded-pill border border-brand-sky text-brand-sky px-6 py-3 font-medium">How it works</a>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="container max-w-container mx-auto px-4 py-section-sm md:py-section">
    <p class="text-eyebrow uppercase text-brand-sky font-semibold text-center">Process</p>
    <h2 class="mt-2 text-display-md text-center">Three steps to change</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="bg-pastel-sun rounded-card p-6">
        <p class="text-eyebrow uppercase font-semibold text-brand-navy/70">First</p>
        <h3 class="mt-2 text-display-sm text-brand-navy">Choose a child</h3>
        <p class="mt-2 text-ink-700">Browse the gallery and choose the child you want to support.</p>
        <a href="/sponsor-a-child/children" class="mt-4 inline-block rounded-pill border border-brand-navy/30 text-brand-navy px-5 py-2 font-medium">Browse</a>
      </div>
      <div class="bg-pastel-salmon rounded-card p-6">
        <p class="text-eyebrow uppercase font-semibold text-brand-navy/70">Second</p>
        <h3 class="mt-2 text-display-sm text-brand-navy">Set your amount</h3>
        <p class="mt-2 text-ink-700">You decide the monthly gift, starting at just $25.</p>
      </div>
      <div class="bg-pastel-sky rounded-card p-6">
        <p class="text-eyebrow uppercase font-semibold text-brand-navy/70">Third</p>
        <h3 class="mt-2 text-display-sm text-brand-navy">Build a relationship that matters</h3>
        <p class="mt-2 text-ink-700">Receive letters, photos, and watch your child grow stronger.</p>
      </div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <div class="bg-brand-navy text-white rounded-card p-8 md:p-12">
      <p class="text-eyebrow uppercase text-brand-sky font-semibold">Impact</p>
      <h2 class="mt-2 text-display-sm">What sponsorship provides</h2>
      <ul class="mt-4 grid md:grid-cols-2 gap-4 text-white/90">
        <li>• Weekly nutritious meals: food that builds strength and hope</li>
        <li>• Dignified access to education: supplies, uniforms, and the tools to learn</li>
        <li>• Quarterly checkups and treatment when needed</li>
        <li>• Connection with you: letters, photos, and a real relationship</li>
      </ul>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Frequently asked questions</h2>
    <div class="mt-8 max-w-2xl mx-auto">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</PageLayout>
