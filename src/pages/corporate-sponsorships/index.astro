---
import PageLayout from '../../layouts/PageLayout.astro'
import StatTileRow from '../../components/StatTileRow.astro'
import SponsorshipTierTable from '../../components/SponsorshipTierTable.astro'
import LogoCarousel from '../../components/LogoCarousel.astro'
import EmployerMatchWidget from '../../components/EmployerMatchWidget.astro'
import { getTeamMembers, getSponsors, getSponsorshipPackages } from '../../lib/content'

const teamLeaders = await getTeamMembers('leader')
const pointOfContact = teamLeaders.find((m) => m.name === 'Juan Tomasini') ?? teamLeaders[0]
const sponsors = await getSponsors()
const sponsorshipPackages = await getSponsorshipPackages()
---

<PageLayout title="Corporate Sponsorships — Victoria Venezuela Foundation">
  <section class="bg-brand-navy text-white">
    <div class="container max-w-container mx-auto px-4 py-12 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h1 class="text-display-lg">Corporate Sponsorships</h1>
        <p class="mt-3 text-white/85">
          Join the many organizations actively changing the lives of underprivileged children in Venezuela!
        </p>
        <a href="/contact?topic=corporate-partnerships" class="mt-6 inline-block rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">
          Partner with Us
        </a>
      </div>
      <div class="h-56 rounded-card bg-white/10 flex items-center justify-center text-white/60 text-sm">Image here</div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 py-section-sm md:py-section">
    <LogoCarousel logos={sponsors} />
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Our Impact in Numbers</h2>
    <div class="mt-8">
      <StatTileRow
        stats={[
          { value: '77,300+', label: 'Nutrition program', caption: 'Meals served to children at risk' },
          { value: '1,012', label: 'Healthcare program', caption: 'Critical medical care provided' },
          { value: '24', label: 'Educational program', caption: 'Children with educational support' },
          { value: '41+', label: 'Corporate sponsors', caption: 'Investing in programs in Venezuela' },
        ]}
      />
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Sponsor packages</h2>
    <div class="mt-8">
      <SponsorshipTierTable tiers={sponsorshipPackages} ctaHrefFor={() => '/contact?topic=corporate-partnerships'} />
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <div class="bg-white rounded-card shadow-sm p-8 max-w-md mx-auto text-center">
      <h2 class="text-display-sm">See if your employer will match your donation!</h2>
      <div class="mt-4">
        <EmployerMatchWidget />
      </div>
    </div>
  </section>

  {
    pointOfContact && (
      <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-card shadow-sm p-6">
            <h3 class="font-display text-lg text-brand-navy">Point of Contact</h3>
            <p class="mt-2 text-ink-700">
              Is your organization interested in investing in children and the future of Venezuela? Let's make a
              positive impact together.
            </p>
          </div>
          <div class="bg-pastel-sky rounded-card p-6">
            <p class="font-display text-lg text-brand-navy">{pointOfContact.name}</p>
            <p class="text-sm text-ink-700">{pointOfContact.role}</p>
            <a href="mailto:donate@victoriavenezuelafoundation.org" class="mt-2 block text-brand-sky hover:underline">
              donate@victoriavenezuelafoundation.org
            </a>
          </div>
        </div>
      </section>
    )
  }
</PageLayout>
