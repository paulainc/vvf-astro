---
import PageLayout from '../../layouts/PageLayout.astro'
import PastelCard from '../../components/PastelCard.astro'
import FaqAccordion from '../../components/FaqAccordion.astro'
import EmployerMatchWidget from '../../components/EmployerMatchWidget.astro'
import { getFaqs } from '../../lib/content'
import { generalDonationUrl, corporateSponsorshipInquiryUrl } from '../../lib/donorbox'

const faqs = await getFaqs('donation')
---

<PageLayout title="Ways to Give — Victoria Venezuela Foundation">
  <section class="bg-gray-100">
    <div class="container max-w-container mx-auto px-4 py-12">
      <div class="bg-white rounded-card shadow p-8 max-w-xl ml-auto">
        <h1 class="text-display-md">Ways to give</h1>
        <p class="mt-3 text-ink-700">Find the giving option that's right for you. Every gift transforms a child's life.</p>
      </div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 py-section-sm md:py-section">
    <p class="text-eyebrow uppercase text-brand-sky font-semibold text-center">Ways to give</p>
    <h2 class="mt-2 text-display-md text-center">Many ways to make a difference</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <PastelCard
        tone="yellow"
        title="Sponsor a child"
        body="Support one child with a monthly gift, starting at $25. Receive letters, photos and progress updates."
        cta={{ label: 'Sponsor', href: '/sponsor-a-child' }}
      />
      <PastelCard
        tone="pink"
        title="Monthly giving"
        body="Sustain our programs with a recurring gift. Flexible amount, easy to manage, cancel anytime."
        cta={{ label: 'Donate', href: generalDonationUrl() }}
      />
      <PastelCard
        tone="pink"
        title="One-time donation"
        body="Make an immediate difference with a single gift of any size. In fiscal 2025, 95% of funds went to programs."
        cta={{ label: 'Donate', href: generalDonationUrl() }}
      />
      <PastelCard
        tone="blue"
        title="Corporate partnership"
        body="Tiered sponsorships with visibility and employee engagement. Event sponsorships and matching gifts available."
        cta={{ label: 'Partner', href: corporateSponsorshipInquiryUrl() }}
      />
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <div class="bg-white rounded-card shadow-sm p-8">
      <h2 class="text-display-sm text-center">See if your employer will match your donation!</h2>
      <div class="mt-4">
        <EmployerMatchWidget />
      </div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <div class="bg-pastel-sky rounded-card p-8 grid md:grid-cols-2 gap-6 items-center">
      <div>
        <p class="text-eyebrow uppercase font-semibold text-brand-navy/70">Funds</p>
        <h2 class="mt-2 text-display-sm text-brand-navy">Give through a donor-advised fund</h2>
        <p class="mt-2 text-ink-700">VVF accepts grants from donor-advised funds. EIN: 88-3282100.</p>
        <a href="/contact?topic=donation-support" class="mt-4 inline-block rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">
          DAF Donations Help Request
        </a>
      </div>
      <div class="h-48 rounded-card bg-white/60 flex items-center justify-center text-ink-500 text-sm">Image here</div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Frequently asked questions</h2>
    <div class="mt-8 max-w-2xl mx-auto">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</PageLayout>
