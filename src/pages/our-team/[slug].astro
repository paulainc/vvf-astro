---
import PageLayout from '../../layouts/PageLayout.astro'
import { getTeamMemberBySlug } from '../../lib/content'

// Only board/leader tiers get a detail route. When a person appears in both
// (see cms-collections/spec.md), getTeamMemberBySlug prefers the board bio.
const member = await getTeamMemberBySlug(Astro.params.slug!)
if (!member) return new Response('Not found', { status: 404 })
---

<PageLayout title={`${member.name} — Our Team`}>
  <section class="bg-brand-navy text-white">
    <div class="container max-w-container mx-auto px-4 py-10">
      <p class="text-eyebrow uppercase text-brand-sky font-semibold">Our Team</p>
      <h1 class="mt-2 text-display-lg">{member.name}</h1>
      <p class="text-white/80">{member.role}</p>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 py-10">
    <div class="bg-white rounded-card shadow p-8 grid md:grid-cols-[220px_1fr] gap-8 -mt-16">
      <div class="w-full aspect-square rounded-card bg-gray-200 overflow-hidden">
        {
          member.imageUrl ? (
            <img src={member.imageUrl} alt={member.name} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-ink-500 text-sm">Photo</div>
          )
        }
      </div>
      <div>
        {member.quote && <p class="text-lg font-display text-brand-navy">"{member.quote}"</p>}
        <div class="mt-4 flex gap-6 text-sm text-ink-500">
          {member.since && (
            <div>
              <p class="text-eyebrow uppercase">Since</p>
              <p class="font-semibold text-ink-900">{member.since}</p>
            </div>
          )}
          {member.from && (
            <div>
              <p class="text-eyebrow uppercase">From</p>
              <p class="font-semibold text-ink-900">{member.from}</p>
            </div>
          )}
          {member.basedIn && (
            <div>
              <p class="text-eyebrow uppercase">Based in</p>
              <p class="font-semibold text-ink-900">{member.basedIn}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="mt-8 grid md:grid-cols-[1fr_320px] gap-8">
      <div class="prose max-w-none text-ink-700">
        {member.bio && <p>{member.bio}</p>}
        {member.longBio && member.longBio.split('\n\n').map((p) => <p>{p}</p>)}
      </div>

      {
        member.background && member.background.length > 0 && (
          <aside class="bg-pastel-sun rounded-card p-6 h-fit">
            <p class="text-eyebrow uppercase font-semibold text-brand-navy/70">Background</p>
            <dl class="mt-3 space-y-3">
              {member.background.map((b) => (
                <div>
                  <dt class="font-semibold text-brand-navy">{b.label}</dt>
                  <dd class="text-sm text-ink-700">{b.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }
    </div>
  </section>
</PageLayout>
